<Window x:Class="OtimizadorJogos.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Otimizador de Jogos"
        Width="980" Height="760"
        MinWidth="820" MinHeight="580"
        WindowStartupLocation="CenterScreen"
        Icon="Assets/icon.ico"
        Background="{StaticResource CorFundo}"
        Foreground="{StaticResource CorTexto}"
        FontFamily="{StaticResource FonteTexto}"
        FontSize="14"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolParaVisibilidade" />
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ================================================= Conteúdo -->
        <Grid Grid.Row="0" Margin="32,28,32,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Cabeçalho -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border Width="48" Height="48" CornerRadius="12" Background="{StaticResource GradienteLogo}">
                    <TextBlock Style="{StaticResource Icone}" Text="&#xE945;" FontSize="22" Foreground="White"
                               HorizontalAlignment="Center" />
                </Border>

                <StackPanel Grid.Column="1" Margin="16,0,16,0" VerticalAlignment="Center">
                    <TextBlock Text="Otimizador de Jogos" FontSize="22" FontWeight="SemiBold" />
                    <TextBlock Margin="0,2,0,0" Foreground="{StaticResource CorTextoSecundario}" TextWrapping="Wrap"
                               Text="Ajustes do Windows para jogar melhor. Tudo pode ser desfeito com um clique." />
                </StackPanel>

                <Border Grid.Column="2" VerticalAlignment="Center" Padding="14,7" CornerRadius="16"
                        Background="{StaticResource CorSuperficie}" BorderBrush="{StaticResource CorBorda}" BorderThickness="1">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="8" Height="8" Fill="{StaticResource CorSucesso}" VerticalAlignment="Center" />
                        <TextBlock Margin="8,0,0,0" FontSize="13" Text="{Binding TextoResumo}" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Faixa de confiança -->
            <Border Grid.Row="1" Margin="0,24,0,0" Padding="18,14" CornerRadius="12"
                    Background="{StaticResource CorSuperficie}" BorderBrush="{StaticResource CorBorda}" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Style="{StaticResource Icone}" Text="&#xEA18;" FontSize="22"
                               Foreground="{StaticResource CorSucesso}" />

                    <StackPanel Grid.Column="1" Margin="14,0,14,0" VerticalAlignment="Center">
                        <TextBlock Text="Backup automático antes de cada mudança" FontWeight="SemiBold" />
                        <TextBlock Margin="0,2,0,0" FontSize="13" TextWrapping="Wrap"
                                   Foreground="{StaticResource CorTextoSecundario}"
                                   Text="O valor original de cada ajuste fica salvo no seu PC. Nada mexe no jogo nem no anti-cheat." />
                    </StackPanel>

                    <Button Grid.Column="2" Style="{StaticResource BotaoLink}" VerticalAlignment="Center"
                            Command="{Binding AbrirPastaCommand}"
                            ToolTip="Abre C:\ProgramData\OtimizadorJogos, onde ficam o backup e o log">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icone}" Text="&#xE838;" FontSize="14" Margin="0,0,6,0" />
                            <TextBlock Text="Abrir pasta do backup" />
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>

            <!-- Aviso de reinício -->
            <Border Grid.Row="2" Margin="0,12,0,0" Padding="18,12" CornerRadius="12"
                    Background="{StaticResource CorAlertaFundo}" BorderBrush="{StaticResource CorAlertaBorda}" BorderThickness="1"
                    Visibility="{Binding MostrarAvisoReinicio, Converter={StaticResource BoolParaVisibilidade}}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource Icone}" Text="&#xE7BA;" FontSize="16" Foreground="{StaticResource CorAlerta}" />
                    <TextBlock Margin="12,0,0,0" Foreground="{StaticResource CorAlertaTexto}" VerticalAlignment="Center"
                               Text="Reinicie o PC para que todos os ajustes passem a valer." />
                </StackPanel>
            </Border>

            <!-- Lista de ajustes -->
            <Grid Grid.Row="3" Margin="0,24,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <DockPanel Margin="0,0,0,12" LastChildFill="False">
                    <TextBlock DockPanel.Dock="Left" Text="Ajustes" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <Button DockPanel.Dock="Right" Style="{StaticResource BotaoLink}" Content="Marcar todos"
                            Command="{Binding MarcarTodosCommand}" />
                </DockPanel>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                              Padding="0,0,10,16" Focusable="False">
                    <ItemsControl ItemsSource="{Binding Ajustes}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border x:Name="Cartao" Margin="0,0,0,10" Padding="18,16" CornerRadius="12"
                                        Background="{StaticResource CorCartao}" BorderBrush="{StaticResource CorBorda}" BorderThickness="1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <Border Width="40" Height="40" CornerRadius="10" VerticalAlignment="Top"
                                                Background="{StaticResource CorSuperficie}" BorderBrush="{StaticResource CorBorda}" BorderThickness="1">
                                            <TextBlock Style="{StaticResource Icone}" Text="{Binding Icone}" FontSize="18"
                                                       Foreground="{StaticResource CorAcento}" HorizontalAlignment="Center" />
                                        </Border>

                                        <StackPanel Grid.Column="1" Margin="16,0,20,0">
                                            <TextBlock Text="{Binding Titulo}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" />
                                            <TextBlock Margin="0,4,0,0" FontSize="13" LineHeight="19" TextWrapping="Wrap"
                                                       Foreground="{StaticResource CorTextoSecundario}" Text="{Binding Descricao}" />
                                            <WrapPanel Margin="0,10,0,0">
                                                <Border Style="{StaticResource Etiqueta}">
                                                    <TextBlock Style="{StaticResource TextoEtiqueta}" Text="{Binding Categoria}" />
                                                </Border>
                                                <Border Style="{StaticResource Etiqueta}">
                                                    <TextBlock Style="{StaticResource TextoEtiqueta}" Text="{Binding TextoImpacto}" />
                                                </Border>
                                                <Border Style="{StaticResource Etiqueta}"
                                                        Visibility="{Binding RequerReinicio, Converter={StaticResource BoolParaVisibilidade}}">
                                                    <TextBlock Style="{StaticResource TextoEtiqueta}" Text="Requer reinício" />
                                                </Border>
                                            </WrapPanel>
                                        </StackPanel>

                                        <StackPanel Grid.Column="2" VerticalAlignment="Center" MinWidth="150">
                                            <CheckBox Style="{StaticResource Interruptor}" HorizontalAlignment="Right"
                                                      IsChecked="{Binding Selecionado, Mode=TwoWay}"
                                                      ToolTip="Ligar ou desligar este ajuste" />
                                            <TextBlock x:Name="TextoStatus" Margin="0,8,0,0" FontSize="12" HorizontalAlignment="Right"
                                                       TextAlignment="Right" Foreground="{StaticResource CorTextoFraco}"
                                                       Text="{Binding StatusTexto}" />
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <DataTemplate.Triggers>
                                    <Trigger SourceName="Cartao" Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Cartao" Property="Background" Value="{StaticResource CorCartaoHover}" />
                                    </Trigger>
                                    <DataTrigger Binding="{Binding StatusTipo}" Value="Ativo">
                                        <Setter TargetName="TextoStatus" Property="Foreground" Value="{StaticResource CorSucesso}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding StatusTipo}" Value="Pendente">
                                        <Setter TargetName="TextoStatus" Property="Foreground" Value="{StaticResource CorAlerta}" />
                                        <Setter TargetName="Cartao" Property="BorderBrush" Value="{StaticResource CorAlertaBorda}" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Grid>

        <!-- ================================================= Barra de ações -->
        <Border Grid.Row="1" Padding="32,16" Background="{StaticResource CorSuperficie}"
                BorderBrush="{StaticResource CorBorda}" BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock FontWeight="SemiBold" Text="{Binding TextoPendentes}" />
                    <TextBlock Margin="0,2,0,0" FontSize="12" Foreground="{StaticResource CorTextoSecundario}"
                               TextTrimming="CharacterEllipsis" Text="{Binding Status}" ToolTip="{Binding Status}" />
                </StackPanel>

                <Button Grid.Column="1" Margin="0,0,10,0" Style="{StaticResource BotaoSecundario}"
                        Command="{Binding RestaurarTudoCommand}"
                        ToolTip="Desfaz todos os ajustes e volta o Windows ao estado original">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Icone}" Text="&#xE777;" FontSize="14" Margin="0,0,8,0" />
                        <TextBlock Text="Restaurar tudo" />
                    </StackPanel>
                </Button>

                <Button Grid.Column="2" Margin="0,0,10,0" Style="{StaticResource BotaoSecundario}"
                        Content="Descartar" Command="{Binding DescartarCommand}"
                        ToolTip="Volta os interruptores para o estado atual, sem mudar nada" />

                <Button Grid.Column="3" Style="{StaticResource BotaoPrimario}" Command="{Binding AplicarCommand}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Icone}" Text="&#xE73E;" FontSize="14" Margin="0,0,8,0" />
                        <TextBlock Text="Aplicar alterações" />
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <!-- ================================================= Tela de "trabalhando" -->
        <Grid Grid.RowSpan="2" Background="#D90E1014"
              Visibility="{Binding Ocupado, Converter={StaticResource BoolParaVisibilidade}}">
            <Border MinWidth="340" Padding="36,28" CornerRadius="14"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    Background="{StaticResource CorSuperficie}" BorderBrush="{StaticResource CorBorda}" BorderThickness="1">
                <StackPanel HorizontalAlignment="Center">
                    <Ellipse Width="40" Height="40" StrokeThickness="3" Stroke="{StaticResource CorAcento}"
                             StrokeDashArray="13 26" StrokeDashCap="Round" RenderTransformOrigin="0.5,0.5">
                        <Ellipse.RenderTransform>
                            <RotateTransform Angle="0" />
                        </Ellipse.RenderTransform>
                        <Ellipse.Triggers>
                            <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                <BeginStoryboard>
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                         From="0" To="360" Duration="0:0:1" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </Ellipse.Triggers>
                    </Ellipse>
                    <TextBlock Margin="0,18,0,0" MaxWidth="380" HorizontalAlignment="Center" TextAlignment="Center"
                               TextWrapping="Wrap" FontWeight="SemiBold" Text="{Binding MensagemOcupado}" />
                    <TextBlock Margin="0,4,0,0" HorizontalAlignment="Center" FontSize="12"
                               Foreground="{StaticResource CorTextoFraco}" Text="Não feche o programa." />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>

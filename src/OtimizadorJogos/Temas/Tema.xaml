<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ===================================================== Cores -->
    <SolidColorBrush x:Key="CorFundo" Color="#0E1014" />
    <SolidColorBrush x:Key="CorSuperficie" Color="#151820" />
    <SolidColorBrush x:Key="CorCartao" Color="#1A1E27" />
    <SolidColorBrush x:Key="CorCartaoHover" Color="#1F2430" />
    <SolidColorBrush x:Key="CorBorda" Color="#272C38" />
    <SolidColorBrush x:Key="CorBordaForte" Color="#3A4150" />

    <SolidColorBrush x:Key="CorTexto" Color="#ECEEF3" />
    <SolidColorBrush x:Key="CorTextoSecundario" Color="#9AA3B2" />
    <SolidColorBrush x:Key="CorTextoFraco" Color="#6B7383" />

    <SolidColorBrush x:Key="CorAcento" Color="#3B82F6" />
    <SolidColorBrush x:Key="CorAcentoHover" Color="#5B97F8" />
    <SolidColorBrush x:Key="CorAcentoPressionado" Color="#2F6BD0" />

    <SolidColorBrush x:Key="CorSucesso" Color="#34D399" />
    <SolidColorBrush x:Key="CorAlerta" Color="#FBBF24" />
    <SolidColorBrush x:Key="CorAlertaTexto" Color="#FDE68A" />
    <SolidColorBrush x:Key="CorAlertaFundo" Color="#2A2312" />
    <SolidColorBrush x:Key="CorAlertaBorda" Color="#5C4813" />

    <LinearGradientBrush x:Key="GradienteLogo" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#3B82F6" Offset="0" />
        <GradientStop Color="#6366F1" Offset="1" />
    </LinearGradientBrush>

    <!-- ===================================================== Fontes -->
    <FontFamily x:Key="FonteTexto">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="FonteIcones">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

    <Style x:Key="Icone" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FonteIcones}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- ===================================================== Botões -->
    <Style x:Key="BotaoBase" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource CorTexto}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Padding" Value="18,10" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Raiz"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="8"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Raiz" Property="BorderBrush" Value="{StaticResource CorAcentoHover}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Raiz" Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="BotaoPrimario" TargetType="Button" BasedOn="{StaticResource BotaoBase}">
        <Setter Property="Background" Value="{StaticResource CorAcento}" />
        <Setter Property="BorderBrush" Value="{StaticResource CorAcento}" />
        <Setter Property="Foreground" Value="White" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource CorAcentoHover}" />
                <Setter Property="BorderBrush" Value="{StaticResource CorAcentoHover}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{StaticResource CorAcentoPressionado}" />
                <Setter Property="BorderBrush" Value="{StaticResource CorAcentoPressionado}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="BotaoSecundario" TargetType="Button" BasedOn="{StaticResource BotaoBase}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{StaticResource CorBordaForte}" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource CorCartaoHover}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{StaticResource CorCartao}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="BotaoLink" TargetType="Button" BasedOn="{StaticResource BotaoBase}">
        <Setter Property="Foreground" Value="{StaticResource CorAcento}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="4,2" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="Normal" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="{StaticResource CorAcentoHover}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ===================================================== Interruptor (CheckBox) -->
    <Style x:Key="Interruptor" TargetType="CheckBox">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Grid x:Name="Raiz" Width="44" Height="24" Background="Transparent">
                        <Border x:Name="Trilho"
                                CornerRadius="12"
                                Background="#232833"
                                BorderBrush="{StaticResource CorBordaForte}"
                                BorderThickness="1" />
                        <Ellipse x:Name="Botao"
                                 Width="16" Height="16"
                                 Margin="4,0,0,0"
                                 HorizontalAlignment="Left"
                                 Fill="#AEB6C4" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Trilho" Property="BorderBrush" Value="#5A6478" />
                            <Setter TargetName="Botao" Property="Fill" Value="#D5DAE3" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Trilho" Property="BorderBrush" Value="{StaticResource CorAcentoHover}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Trilho" Property="Background" Value="{StaticResource CorAcento}" />
                            <Setter TargetName="Trilho" Property="BorderBrush" Value="{StaticResource CorAcento}" />
                            <Setter TargetName="Botao" Property="HorizontalAlignment" Value="Right" />
                            <Setter TargetName="Botao" Property="Margin" Value="0,0,4,0" />
                            <Setter TargetName="Botao" Property="Fill" Value="White" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Raiz" Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================================================== Etiquetas -->
    <Style x:Key="Etiqueta" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource CorSuperficie}" />
        <Setter Property="BorderBrush" Value="{StaticResource CorBorda}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="8,2" />
        <Setter Property="Margin" Value="0,0,6,0" />
    </Style>

    <Style x:Key="TextoEtiqueta" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="Foreground" Value="{StaticResource CorTextoSecundario}" />
    </Style>

    <!-- ===================================================== Barra de rolagem fina -->
    <Style TargetType="ScrollBar">
        <Setter Property="Width" Value="8" />
        <Setter Property="MinWidth" Value="8" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid Background="Transparent">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.Thumb>
                                <Thumb>
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border x:Name="Polegar" CornerRadius="4" Background="#2F3542" />
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Polegar" Property="Background" Value="#4A5263" />
                                                </Trigger>
                                                <Trigger Property="IsDragging" Value="True">
                                                    <Setter TargetName="Polegar" Property="Background" Value="#5A6478" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================================================== Dica (tooltip) -->
    <Style TargetType="ToolTip">
        <Setter Property="Background" Value="{StaticResource CorSuperficie}" />
        <Setter Property="Foreground" Value="{StaticResource CorTexto}" />
        <Setter Property="BorderBrush" Value="{StaticResource CorBordaForte}" />
        <Setter Property="Padding" Value="10,6" />
    </Style>

</ResourceDictionary>
